set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(PSYDOOM_PS4 TRUE CACHE BOOL "Build for OpenOrbis")
set(OO_PS4_TOOLCHAIN "/opt/openorbis/OpenOrbis/PS4Toolchain" CACHE PATH "OpenOrbis SDK")
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_SYSROOT "${OO_PS4_TOOLCHAIN}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_FLAGS_INIT "-fPIC -include ${CMAKE_CURRENT_LIST_DIR}/../ps4/platform/abi.h -D__PS4__ -D__ORBIS__ -D_BSD_SOURCE -isystem ${OO_PS4_TOOLCHAIN}/include")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -funwind-tables -nostdinc++ -isystem ${OO_PS4_TOOLCHAIN}/include/c++/v1 -D_LIBCPP_HAS_NO_LOCALE")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -nostdlib -Wl,-pie -Wl,--script=${CMAKE_CURRENT_LIST_DIR}/../ps4/link.x -Wl,--eh-frame-hdr -Wl,-z,max-page-size=0x4000 -L${OO_PS4_TOOLCHAIN}/lib ${OO_PS4_TOOLCHAIN}/lib/crt1.o")
set(CMAKE_FIND_ROOT_PATH "${OO_PS4_TOOLCHAIN}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
